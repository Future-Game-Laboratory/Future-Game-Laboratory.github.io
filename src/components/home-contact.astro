---
import { CONTACT } from '@/consts'
import { withBase } from '@/lib/paths'
import { Icon } from 'astro-icon/components'

const socialLinks = CONTACT.socials
  .map((channel) => ({ ...channel, href: channel.href.trim() }))
  .filter((channel) => channel.href)
const channels = [
  ...socialLinks.map((channel) => ({ ...channel, external: true })),
  {
    label: 'RSS',
    href: withBase('/rss.xml'),
    icon: 'lucide:rss',
    external: false,
  },
]
---

<section class="home-socials" aria-labelledby="home-socials-title">
  <h2 id="home-socials-title">SNS</h2>
  <nav aria-label="社交平台与订阅">
    <ul>
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noreferrer noopener' : undefined}
              aria-label={channel.label}
            >
              <Icon name={channel.icon} aria-hidden="true" />
              <span>{channel.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .home-socials {
    width: 100%;
  }

  .home-socials h2 {
    border-bottom: 1px solid var(--foreground);
    padding-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 740;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .home-socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }

  .home-socials a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 4px;
    background: var(--foreground);
    color: var(--background);
    padding: 0.65rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    transition:
      background-color 160ms var(--ease-signal),
      color 160ms var(--ease-signal),
      box-shadow 160ms var(--ease-signal);
  }

  .home-socials a:hover {
    box-shadow: var(--signal-shadow);
  }

  .home-socials a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .home-socials :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-socials a {
      transition: none;
    }
  }
</style>
