---
import home from '@/data/home.json'
import { withBase } from '@/lib/paths'
import { Icon } from 'astro-icon/components'

const socialLinks = home.socials
  .map((channel) => ({ ...channel, href: channel.href.trim() }))
  .filter((channel) => channel.href)
const channels = [
  ...socialLinks.map((channel) => ({ ...channel, external: true })),
  {
    label: 'GitHub',
    href: 'https://github.com/Future-Game-Laboratory',
    icon: 'lucide:github',
    external: true,
  },
  {
    label: 'RSS',
    href: withBase('/rss.xml'),
    icon: 'lucide:rss',
    external: false,
  },
]
---

<section class="home-socials" aria-labelledby="home-socials-title">
  <h2 id="home-socials-title">SNS</h2>
  <nav aria-label="社交平台与订阅">
    <ul>
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noreferrer noopener' : undefined}
              aria-label={channel.label}
            >
              <Icon name={channel.icon} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .home-socials {
    width: 100%;
  }

  .home-socials h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .home-socials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-socials a {
    display: inline-flex;
    width: 2.75rem;
    min-height: 2.75rem;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--foreground);
    border-radius: 4px;
    background: var(--background);
    color: var(--foreground);
    padding: 0;
    transition:
      transform 160ms var(--ease-signal),
      box-shadow 160ms var(--ease-signal);
  }

  .home-socials a:hover {
    transform: translateY(-2px);
    box-shadow: var(--signal-shadow);
  }

  .home-socials a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .home-socials :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-socials a {
      transition: none;
    }

    .home-socials a:hover {
      transform: none;
    }
  }
</style>
