---
import TitleReveal from '@/components/title-reveal.astro'

interface Props {
  label?: string
  title: string
  description?: string
}

const { label, title, description } = Astro.props
---

<header class="page-hero">
  {
    label && (
      <p class="signal-label" data-signal-label>
        {label}
      </p>
    )
  }
  <TitleReveal text={title} />
  {description && <p>{description}</p>}
  <slot />
</header>
