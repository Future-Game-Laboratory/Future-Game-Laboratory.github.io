---
interface Slide {
  src: string
  alt: string
}

interface Props {
  slides: Slide[]
  interval?: number
}

const { slides, interval = 5200 }: Props = Astro.props
const total = String(slides.length).padStart(2, '0')
---

{
  slides.length > 0 && (
    <section
      class="poster-carousel"
      data-poster-carousel
      data-carousel-interval={interval}
      aria-label="首页海报"
      aria-roledescription="carousel"
    >
      <div class="poster-carousel__viewport">
        {slides.map((slide, index) => (
          <figure
            class:list={[
              'poster-carousel__slide',
              { 'is-active': index === 0 },
            ]}
            data-carousel-slide
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <img
              src={slide.src}
              alt={slide.alt}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              decoding="async"
              draggable="false"
            />
          </figure>
        ))}
      </div>

      {slides.length > 1 && (
        <div class="poster-carousel__controls">
          <button type="button" data-carousel-previous aria-label="上一张海报">
            <span aria-hidden="true">←</span>
          </button>
          <p aria-live="polite" aria-atomic="true">
            <span data-carousel-current>01</span>
            <span aria-hidden="true"> / </span>
            <span>{total}</span>
          </p>
          <div class="poster-carousel__dots" aria-label="选择海报">
            {slides.map((_, index) => (
              <button
                type="button"
                class:list={{ 'is-active': index === 0 }}
                data-carousel-dot={index}
                aria-label={`查看第 ${index + 1} 张海报`}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))}
          </div>
          <button type="button" data-carousel-next aria-label="下一张海报">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      )}
    </section>
  )
}

<style>
  .poster-carousel {
    width: min(100%, 54rem);
    margin-inline: auto;
  }

  .poster-carousel__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-top: 1px solid var(--foreground);
    border-bottom: 1px solid var(--foreground);
    background: var(--background);
  }

  .poster-carousel__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 540ms var(--ease-reveal),
      filter 540ms var(--ease-reveal);
  }

  .poster-carousel__slide.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .poster-carousel__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .poster-carousel__controls {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.8rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }

  .poster-carousel__controls > button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
  }

  .poster-carousel__controls > button:hover {
    text-shadow:
      1px 0 var(--signal-magenta),
      -1px 0 var(--signal-cyan);
  }

  .poster-carousel__controls p {
    margin: 0;
    white-space: nowrap;
  }

  .poster-carousel__dots {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
  }

  .poster-carousel__dots button {
    position: relative;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .poster-carousel__dots button::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.35rem;
    height: 1px;
    background: var(--border);
    content: '';
    transform: translate(-50%, -50%);
    transition:
      width 180ms var(--ease-signal),
      background-color 180ms var(--ease-signal);
  }

  .poster-carousel__dots button.is-active::before {
    width: 2.25rem;
    background: var(--foreground);
  }

  @media (max-width: 640px) {
    .poster-carousel__viewport {
      aspect-ratio: 4 / 3;
    }

    .poster-carousel__controls {
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-carousel__slide,
    .poster-carousel__dots button::before {
      transition: none;
    }
  }
</style>

<script>
  function setupPosterCarousels() {
    document
      .querySelectorAll<HTMLElement>('[data-poster-carousel]')
      .forEach((carousel) => {
        if (carousel.dataset.carouselReady === 'true') return
        carousel.dataset.carouselReady = 'true'

        const slides = Array.from(
          carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'),
        )
        const dots = Array.from(
          carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'),
        )
        const current = carousel.querySelector<HTMLElement>(
          '[data-carousel-current]',
        )
        if (slides.length < 2) return

        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches
        const interval = Number(carousel.dataset.carouselInterval) || 5200
        let activeIndex = 0
        let timer = 0

        const show = (nextIndex: number) => {
          activeIndex = (nextIndex + slides.length) % slides.length
          slides.forEach((slide, index) => {
            const active = index === activeIndex
            slide.classList.toggle('is-active', active)
            slide.setAttribute('aria-hidden', active ? 'false' : 'true')
          })
          dots.forEach((dot, index) => {
            const active = index === activeIndex
            dot.classList.toggle('is-active', active)
            if (active) dot.setAttribute('aria-current', 'true')
            else dot.removeAttribute('aria-current')
          })
          if (current)
            current.textContent = String(activeIndex + 1).padStart(2, '0')
        }

        const stop = () => window.clearInterval(timer)
        const start = () => {
          stop()
          if (reducedMotion || document.hidden) return
          timer = window.setInterval(() => show(activeIndex + 1), interval)
        }

        carousel
          .querySelector<HTMLButtonElement>('[data-carousel-previous]')
          ?.addEventListener('click', () => {
            show(activeIndex - 1)
            start()
          })
        carousel
          .querySelector<HTMLButtonElement>('[data-carousel-next]')
          ?.addEventListener('click', () => {
            show(activeIndex + 1)
            start()
          })
        dots.forEach((dot, index) =>
          dot.addEventListener('click', () => {
            show(index)
            start()
          }),
        )
        carousel.addEventListener('mouseenter', stop)
        carousel.addEventListener('mouseleave', start)
        carousel.addEventListener('focusin', stop)
        carousel.addEventListener('focusout', (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !carousel.contains(event.relatedTarget)
          ) {
            start()
          }
        })
        const handleVisibilityChange = () => start()
        document.addEventListener('visibilitychange', handleVisibilityChange)
        document.addEventListener(
          'astro:before-swap',
          () => {
            stop()
            document.removeEventListener(
              'visibilitychange',
              handleVisibilityChange,
            )
          },
          { once: true },
        )
        start()
      })
  }

  setupPosterCarousels()
  document.addEventListener('astro:page-load', setupPosterCarousels)
</script>
