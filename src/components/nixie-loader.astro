---
const digits = Array.from({ length: 10 }, (_, digit) => String(digit))
const tubeIndexes = Array.from({ length: 8 }, (_, index) => index)
---

<div
  class="nixie-loader"
  id="nixie-loader"
  role="status"
  aria-live="polite"
  aria-label="未来游戏研究所正在启动"
>
  <div class="nixie-loader__frame">
    <header class="nixie-loader__header" aria-hidden="true">
      <span>未来游戏研究所</span>
      <span>COLD CATHODE ARRAY / N-08</span>
    </header>

    <div class="nixie-loader__apparatus">
      <div
        class="nixie-loader__progress"
        id="nixie-progress"
        role="progressbar"
        aria-label="加载进度"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext="加载进度 00.000000%"
      >
        <div class="nixie-loader__bank" aria-hidden="true">
          {
            tubeIndexes.map((tubeIndex) => (
              <>
                {tubeIndex === 2 && (
                  <span class="nixie-separator">
                    <span />
                  </span>
                )}
                <span
                  class="nixie-tube"
                  style={`--tube-index: ${tubeIndex}`}
                  data-nixie-tube
                >
                  <span class="nixie-tube__stem" />
                  <span class="nixie-tube__digits">
                    {digits.map((digit) => (
                      <span
                        class:list={[
                          'nixie-tube__digit',
                          { 'is-active': digit === '0' },
                        ]}
                        data-digit={digit}
                      >
                        {digit}
                      </span>
                    ))}
                  </span>
                  <span class="nixie-tube__mesh" />
                  <span class="nixie-tube__base" />
                </span>
              </>
            ))
          }
        </div>
      </div>
      <div class="nixie-loader__rail" aria-hidden="true"></div>
    </div>

    <footer class="nixie-loader__telemetry" aria-hidden="true">
      <span><i></i> HV 170 VDC / STABLE</span>
      <span>LOAD FRACTION / PERCENT</span>
    </footer>
  </div>

  <button class="nixie-loader__skip" id="nixie-loader-skip" type="button">
    跳过启动 <span aria-hidden="true">↗</span>
  </button>
</div>

<noscript
  ><style>
    .nixie-loader {
      display: none !important;
    }
  </style></noscript
>

<style>
  .nixie-loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #ffffff;
    color: #0b0d10;
    transition:
      opacity 420ms var(--ease-reveal),
      filter 420ms var(--ease-reveal),
      visibility 420ms step-end;
  }

  :global(html[data-boot='seen']) .nixie-loader,
  .nixie-loader[hidden] {
    display: none;
  }

  .nixie-loader::before {
    position: absolute;
    right: 10%;
    bottom: 15%;
    left: 10%;
    height: 10%;
    background: radial-gradient(
      ellipse at center,
      rgb(13 17 20 / 12%),
      transparent 68%
    );
    content: '';
    filter: blur(18px);
    transform: scaleX(0.8);
  }

  .nixie-loader.is-closing {
    visibility: hidden;
    opacity: 0;
    filter: blur(2px);
  }

  .nixie-loader__frame {
    position: relative;
    width: min(94vw, 52rem);
    padding: clamp(0.8rem, 3vw, 1.8rem);
    isolation: isolate;
  }

  .nixie-loader__header,
  .nixie-loader__telemetry {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #33383d;
    font-family: var(--font-mono);
    font-size: clamp(0.54rem, 1.5vw, 0.66rem);
    font-weight: 590;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .nixie-loader__header {
    align-items: end;
    border-bottom: 1px solid #aeb4b9;
    padding-bottom: 0.7rem;
  }

  .nixie-loader__header span:first-child {
    color: #0b0d10;
    font-family: var(--font-sans);
    font-size: clamp(0.72rem, 2vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0;
  }

  .nixie-loader__apparatus {
    position: relative;
    padding: clamp(1.5rem, 5vw, 3.2rem) clamp(0.15rem, 1vw, 0.6rem)
      clamp(1.9rem, 5vw, 3rem);
    animation: apparatus-enter 620ms var(--ease-reveal) both;
  }

  .nixie-loader__progress {
    position: relative;
    z-index: 2;
  }

  .nixie-loader__bank {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(0.22rem, 0.9vw, 0.65rem);
    perspective: 900px;
  }

  .nixie-tube {
    --tube-width: clamp(1.85rem, 7.2vw, 4.35rem);
    --tube-height: clamp(4rem, 12.2vw, 7.8rem);
    position: relative;
    display: block;
    width: var(--tube-width);
    height: var(--tube-height);
    flex: 0 0 var(--tube-width);
    border: 1px solid rgb(50 57 62 / 56%);
    border-radius: 46% 46% 19% 19% / 18% 18% 10% 10%;
    background:
      linear-gradient(
        96deg,
        rgb(255 255 255 / 88%) 0%,
        rgb(228 234 237 / 24%) 13%,
        rgb(255 255 255 / 4%) 36%,
        rgb(178 188 194 / 12%) 66%,
        rgb(255 255 255 / 72%) 89%,
        rgb(198 207 212 / 22%) 100%
      ),
      radial-gradient(
        ellipse at 50% 76%,
        rgb(255 115 22 / 11%),
        transparent 46%
      );
    box-shadow:
      inset 5px 0 7px rgb(255 255 255 / 78%),
      inset -4px 0 8px rgb(58 70 77 / 14%),
      inset 0 -10px 13px rgb(39 30 23 / 12%),
      0 1px 0 rgb(255 255 255),
      0 12px 19px -14px rgb(20 18 16 / 48%);
    transform-origin: 50% 100%;
    animation: tube-seat 520ms var(--ease-reveal) both;
    animation-delay: calc(90ms + var(--tube-index) * 28ms);
    contain: layout style;
  }

  .nixie-tube::before {
    position: absolute;
    z-index: 5;
    top: 8%;
    bottom: 17%;
    left: 12%;
    width: 13%;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(255 255 255 / 82%),
      transparent
    );
    content: '';
    filter: blur(0.4px);
    opacity: 0.72;
    transform: rotate(3deg);
  }

  .nixie-tube::after {
    position: absolute;
    z-index: 4;
    inset: 5% 9% 11%;
    border: 1px solid rgb(255 255 255 / 62%);
    border-bottom-color: rgb(83 65 52 / 18%);
    border-radius: inherit;
    content: '';
    box-shadow: inset 0 0 9px rgb(32 38 42 / 8%);
    pointer-events: none;
  }

  .nixie-tube__stem {
    position: absolute;
    z-index: 1;
    right: 25%;
    bottom: 7%;
    left: 25%;
    height: 31%;
    border-right: 1px solid rgb(73 65 57 / 42%);
    border-left: 1px solid rgb(73 65 57 / 42%);
  }

  .nixie-tube__stem::before,
  .nixie-tube__stem::after {
    position: absolute;
    bottom: -10%;
    width: 1px;
    height: 58%;
    background: #8d7868;
    content: '';
  }

  .nixie-tube__stem::before {
    left: 24%;
  }

  .nixie-tube__stem::after {
    right: 24%;
  }

  .nixie-tube__digits {
    position: absolute;
    z-index: 2;
    inset: 10% 2% 17%;
    display: grid;
    place-items: center;
  }

  .nixie-tube__digit {
    --digit-x: 0px;
    --digit-y: 0px;
    position: absolute;
    grid-area: 1 / 1;
    color: rgb(37 31 27 / 2%);
    font-family: 'Arial Narrow', 'Helvetica Neue', var(--font-sans);
    font-size: clamp(1.85rem, 6vw, 4.2rem);
    font-stretch: condensed;
    font-weight: 300;
    line-height: 1;
    opacity: 0.19;
    transform: translate(var(--digit-x), var(--digit-y)) scaleX(0.76);
    -webkit-text-stroke: 0.7px rgb(42 38 35 / 72%);
    text-shadow: 0 1px 0 rgb(255 255 255 / 35%);
    transition: opacity 40ms linear;
  }

  .nixie-tube__digit:nth-child(2) {
    --digit-x: -0.35px;
    --digit-y: 0.35px;
  }

  .nixie-tube__digit:nth-child(3n) {
    --digit-x: 0.45px;
    --digit-y: -0.3px;
  }

  .nixie-tube__digit:nth-child(4n) {
    --digit-x: -0.2px;
    --digit-y: -0.45px;
  }

  .nixie-tube__digit.is-active {
    z-index: 2;
    color: rgb(255 121 31 / 10%);
    opacity: 1;
    -webkit-text-stroke: clamp(0.85px, 0.13vw, 1.35px) #ff8a2b;
    text-shadow:
      0 0 1px #fff0d6,
      0 0 4px rgb(255 111 23 / 98%),
      0 0 9px rgb(255 98 12 / 76%),
      0 0 18px rgb(255 91 0 / 42%),
      0 0 32px rgb(255 91 0 / 17%);
    animation: cathode-switch 120ms linear both;
  }

  .nixie-tube__mesh {
    position: absolute;
    z-index: 3;
    inset: 13% 13% 18%;
    border: 1px solid rgb(69 66 62 / 34%);
    border-radius: 42% 42% 10% 10% / 13% 13% 7% 7%;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0 5px,
        rgb(49 48 46 / 17%) 5px 6px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 5px,
        rgb(49 48 46 / 14%) 5px 6px
      );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 18%),
      0 0 4px rgb(255 109 19 / 8%);
    opacity: 0.74;
    pointer-events: none;
  }

  .nixie-tube__base {
    position: absolute;
    z-index: 6;
    right: 9%;
    bottom: -11%;
    left: 9%;
    height: 17%;
    border: 1px solid #27221e;
    border-radius: 2px 2px 5px 5px;
    background: linear-gradient(
      90deg,
      #191715,
      #4d4035 12%,
      #201b18 28%,
      #58493c 52%,
      #1a1715 76%,
      #463a31 90%,
      #171513
    );
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 17%),
      0 4px 5px rgb(12 11 10 / 22%);
  }

  .nixie-tube__base::before,
  .nixie-tube__base::after {
    position: absolute;
    bottom: -38%;
    width: 1px;
    height: 42%;
    background: #79654f;
    box-shadow: 0 0 0 0.3px #c4ae91;
    content: '';
  }

  .nixie-tube__base::before {
    left: 29%;
  }

  .nixie-tube__base::after {
    right: 29%;
  }

  .nixie-separator {
    position: relative;
    display: grid;
    width: clamp(0.35rem, 1.5vw, 0.9rem);
    height: clamp(4rem, 12.2vw, 7.8rem);
    flex: 0 0 clamp(0.35rem, 1.5vw, 0.9rem);
    place-items: center;
  }

  .nixie-separator > span {
    position: relative;
    top: 20%;
    display: block;
    width: clamp(0.35rem, 1.25vw, 0.68rem);
    aspect-ratio: 1;
    border: 1px solid rgb(58 61 62 / 60%);
    border-radius: 50%;
    background: rgb(255 130 46 / 32%);
    box-shadow:
      inset 1px 1px 1px rgb(255 255 255 / 74%),
      0 0 3px #ff7926,
      0 0 10px rgb(255 96 8 / 62%),
      0 0 20px rgb(255 96 8 / 22%);
    animation: pilot-light 1.1s steps(2, end) infinite;
  }

  .nixie-loader__rail {
    position: absolute;
    z-index: 1;
    right: 1.5%;
    bottom: clamp(1.15rem, 3.8vw, 2rem);
    left: 1.5%;
    height: clamp(0.7rem, 2.4vw, 1.2rem);
    border: 1px solid #1c1d1e;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      #5d6061 0%,
      #1c1e1f 19%,
      #090a0a 61%,
      #363838 78%,
      #101112 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 34%),
      0 7px 12px rgb(19 20 20 / 22%);
  }

  .nixie-loader__telemetry {
    align-items: center;
    border-top: 1px solid #aeb4b9;
    padding-top: 0.7rem;
  }

  .nixie-loader__telemetry i {
    display: inline-block;
    width: 0.42rem;
    aspect-ratio: 1;
    margin-right: 0.35rem;
    border: 1px solid #8b3f17;
    border-radius: 50%;
    background: #ff7925;
    box-shadow: 0 0 6px rgb(255 104 16 / 64%);
    vertical-align: 0.02em;
    animation: pilot-light 1.35s steps(2, end) infinite;
  }

  .nixie-loader__skip {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    border: 0;
    border-bottom: 1px solid #7d8387;
    border-radius: 0;
    background: transparent;
    color: #303438;
    padding: 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      border-color 140ms linear,
      color 140ms linear;
  }

  .nixie-loader__skip:hover,
  .nixie-loader__skip:focus-visible {
    border-color: #0b0d10;
    color: #0b0d10;
  }

  @keyframes apparatus-enter {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tube-seat {
    0% {
      opacity: 0.35;
      transform: translateY(5px) rotateX(-2deg) scale(0.985);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotateX(0) scale(1);
    }
  }

  @keyframes cathode-switch {
    0% {
      opacity: 0.24;
      filter: brightness(0.55);
    }
    23% {
      opacity: 1;
      filter: brightness(1.45);
    }
    42% {
      opacity: 0.66;
      filter: brightness(0.82);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  @keyframes pilot-light {
    0%,
    92% {
      opacity: 1;
    }
    93% {
      opacity: 0.72;
    }
    96%,
    100% {
      opacity: 0.94;
    }
  }

  @media (max-width: 520px) {
    .nixie-loader__header span:last-child,
    .nixie-loader__telemetry span:last-child {
      display: none;
    }

    .nixie-loader__apparatus {
      margin-inline: -0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nixie-loader {
      transition-duration: 120ms;
    }

    .nixie-loader__apparatus,
    .nixie-tube,
    .nixie-tube__digit.is-active,
    .nixie-separator > span,
    .nixie-loader__telemetry i {
      animation: none;
    }
  }
</style>

<script>
  function setupNixieLoader() {
    const root = document.documentElement
    const loader = document.getElementById('nixie-loader')
    const skip = document.getElementById('nixie-loader-skip')
    const progress = document.getElementById('nixie-progress')
    const tubes = Array.from(
      document.querySelectorAll<HTMLElement>('[data-nixie-tube]'),
    )
    if (!(loader instanceof HTMLElement)) return

    let seen = root.dataset.boot === 'seen'
    try {
      seen ||= sessionStorage.getItem('institute-boot-seen') === '1'
    } catch {}

    if (seen) {
      loader.hidden = true
      root.dataset.boot = 'seen'
      return
    }

    if (loader.dataset.ready === 'true') return
    loader.dataset.ready = 'true'

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches
    const duration = 1650
    const startedAt = performance.now()
    let animationFrame = 0
    let hideTimer = 0
    let finishTimer = 0
    let lastPaint = -Infinity
    let finished = false

    const renderProgress = (value: number) => {
      const bounded = Math.min(99.999999, Math.max(0, value))
      const formatted = bounded.toFixed(6).padStart(9, '0')
      const characters = formatted.replace('.', '')

      tubes.forEach((tube, index) => {
        const nextDigit = characters[index]
        const active = tube.querySelector<HTMLElement>(
          '.nixie-tube__digit.is-active',
        )
        if (active?.dataset.digit === nextDigit) return
        active?.classList.remove('is-active')
        tube
          .querySelector<HTMLElement>(`[data-digit='${nextDigit}']`)
          ?.classList.add('is-active')
      })

      progress?.setAttribute('aria-valuenow', bounded.toFixed(3))
      progress?.setAttribute('aria-valuetext', `加载进度 ${formatted}%`)
    }

    const finish = () => {
      if (finished) return
      finished = true
      window.cancelAnimationFrame(animationFrame)
      window.clearTimeout(finishTimer)
      renderProgress(99.999999)
      loader.classList.add('is-closing')
      root.dataset.boot = 'seen'
      try {
        sessionStorage.setItem('institute-boot-seen', '1')
      } catch {}
      hideTimer = window.setTimeout(
        () => {
          loader.hidden = true
        },
        reducedMotion ? 120 : 440,
      )
    }

    const tick = (now: number) => {
      const elapsed = now - startedAt
      const ratio = Math.min(1, elapsed / duration)
      const eased = 1 - Math.pow(1 - ratio, 2.35)

      if (now - lastPaint >= 42 || ratio === 1) {
        renderProgress(
          ratio === 1 ? 99.999999 : Math.min(99.999998, eased * 99.999999),
        )
        lastPaint = now
      }

      if (ratio < 1) {
        animationFrame = window.requestAnimationFrame(tick)
      } else {
        finishTimer = window.setTimeout(finish, 210)
      }
    }

    renderProgress(0)
    skip?.addEventListener('click', finish, { once: true })

    if (reducedMotion) {
      renderProgress(99.999999)
      finishTimer = window.setTimeout(finish, 120)
    } else {
      animationFrame = window.requestAnimationFrame(tick)
    }

    window.addEventListener(
      'pagehide',
      () => {
        window.cancelAnimationFrame(animationFrame)
        window.clearTimeout(finishTimer)
        window.clearTimeout(hideTimer)
      },
      { once: true },
    )
  }

  setupNixieLoader()
  document.addEventListener('astro:page-load', setupNixieLoader)
</script>
