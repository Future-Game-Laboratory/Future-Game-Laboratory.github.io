<div
  class="nixie-loader"
  id="nixie-loader"
  role="status"
  aria-live="polite"
  aria-label="未来游戏研究所正在启动"
>
  <div class="nixie-loader__frame" aria-hidden="true">
    <div class="nixie-loader__readout">
      <span class="nixie-tube">0</span>
      <span class="nixie-tube">0</span>
      <span class="nixie-tube">1</span>
    </div>
    <div class="nixie-loader__telemetry">
      <span>未来游戏研究所 / BOOT</span>
      <span id="nixie-timecode">00:00:00</span>
    </div>
    <div class="nixie-loader__track"><i></i></div>
  </div>
  <button class="nixie-loader__skip" id="nixie-loader-skip" type="button">
    跳过启动
  </button>
</div>

<noscript
  ><style>
    .nixie-loader {
      display: none !important;
    }
  </style></noscript
>

<style>
  .nixie-loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #090b0e;
    color: #ffffff;
    transition:
      opacity 380ms var(--ease-reveal),
      visibility 380ms step-end;
  }

  :global(html[data-boot='seen']) .nixie-loader,
  .nixie-loader[hidden] {
    display: none;
  }

  .nixie-loader::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px);
    background-size: 32px 32px;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .nixie-loader.is-closing {
    visibility: hidden;
    opacity: 0;
  }

  .nixie-loader__frame {
    position: relative;
    width: min(86vw, 29rem);
    border: 1px solid #4b2c1e;
    border-radius: 6px;
    padding: clamp(1.3rem, 5vw, 2.5rem);
    background: #090909;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 4%);
  }

  .nixie-loader__readout {
    display: flex;
    justify-content: center;
    gap: clamp(0.55rem, 2vw, 0.9rem);
  }

  .nixie-tube {
    position: relative;
    display: grid;
    width: clamp(4.3rem, 18vw, 6.2rem);
    height: clamp(6.5rem, 27vw, 9.2rem);
    place-items: center;
    overflow: hidden;
    border: 1px solid #5a2c14;
    border-radius: 48% 48% 17% 17% / 22% 22% 12% 12%;
    color: var(--nixie);
    font-family: var(--font-mono);
    font-size: clamp(3.25rem, 12vw, 5rem);
    font-weight: 520;
    line-height: 1;
    text-shadow:
      0 0 7px rgb(255 122 26 / 95%),
      0 0 21px rgb(255 122 26 / 48%),
      0 0 42px rgb(255 122 26 / 18%);
    box-shadow:
      inset 0 -16px 26px rgb(0 0 0 / 72%),
      inset 0 2px 3px rgb(255 255 255 / 8%),
      0 0 22px rgb(255 122 26 / 8%);
    animation: nixie-ignite 820ms steps(2, end) both;
  }

  .nixie-tube::before {
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(255 166 90 / 14%);
    border-radius: inherit;
    content: '';
  }

  .nixie-tube::after {
    position: absolute;
    right: 18%;
    bottom: 8%;
    left: 18%;
    height: 5px;
    border: 1px solid #6a3519;
    border-radius: 50%;
    content: '';
  }

  .nixie-tube:nth-child(2) {
    animation-delay: 90ms;
  }

  .nixie-tube:nth-child(3) {
    animation-delay: 180ms;
  }

  .nixie-loader__telemetry {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    color: #a8afb8;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .nixie-loader__track {
    height: 2px;
    margin-top: 0.85rem;
    overflow: hidden;
    background: #3d2419;
  }

  .nixie-loader__track i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--nixie);
    box-shadow: 0 0 10px rgb(255 122 26 / 80%);
    transform: scaleX(0);
    transform-origin: left;
    animation: nixie-progress 1.2s var(--ease-signal) forwards;
  }

  .nixie-loader__skip {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    border: 1px solid #59606a;
    border-radius: 3px;
    background: transparent;
    color: #c9ced3;
    padding: 0.65rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .nixie-loader__skip:hover {
    border-color: var(--nixie);
    color: #ffffff;
  }

  @keyframes nixie-ignite {
    0%,
    22% {
      color: #5a260d;
      opacity: 0.45;
      text-shadow: none;
    }
    28% {
      color: #ffc08b;
      opacity: 1;
    }
    34% {
      color: #6a2b0b;
      opacity: 0.56;
    }
    48%,
    100% {
      color: var(--nixie);
      opacity: 1;
    }
  }

  @keyframes nixie-progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nixie-loader {
      transition-duration: 120ms;
    }

    .nixie-tube,
    .nixie-loader__track i {
      animation: none;
    }
  }
</style>

<script>
  function setupNixieLoader() {
    const root = document.documentElement
    const loader = document.getElementById('nixie-loader')
    const skip = document.getElementById('nixie-loader-skip')
    const timecode = document.getElementById('nixie-timecode')
    if (!(loader instanceof HTMLElement)) return

    let seen = root.dataset.boot === 'seen'
    try {
      seen ||= sessionStorage.getItem('institute-boot-seen') === '1'
    } catch {}

    if (seen) {
      loader.hidden = true
      root.dataset.boot = 'seen'
      return
    }

    if (loader.dataset.ready === 'true') return
    loader.dataset.ready = 'true'

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches
    const startedAt = performance.now()
    let interval = 0
    let finishTimer = 0

    const finish = () => {
      window.clearInterval(interval)
      window.clearTimeout(finishTimer)
      loader.classList.add('is-closing')
      root.dataset.boot = 'seen'
      try {
        sessionStorage.setItem('institute-boot-seen', '1')
      } catch {}
      window.setTimeout(
        () => {
          loader.hidden = true
        },
        reducedMotion ? 120 : 400,
      )
    }

    if (!reducedMotion && timecode) {
      interval = window.setInterval(() => {
        const centiseconds = Math.min(
          99,
          Math.floor((performance.now() - startedAt) / 10),
        )
        timecode.textContent = `00:00:${String(centiseconds).padStart(2, '0')}`
      }, 40)
    }

    skip?.addEventListener('click', finish, { once: true })
    finishTimer = window.setTimeout(finish, reducedMotion ? 100 : 1320)
  }

  setupNixieLoader()
  document.addEventListener('astro:page-load', setupNixieLoader)
</script>
