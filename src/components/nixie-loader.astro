---
const digits = Array.from({ length: 10 }, (_, digit) => String(digit))
const tubeIndexes = Array.from({ length: 8 }, (_, index) => index)
---

<div
  class="nixie-loader"
  id="nixie-loader"
  role="status"
  aria-live="polite"
  aria-label="未来游戏研究所正在启动"
>
  <div class="nixie-loader__apparatus">
    <div
      class="nixie-loader__progress"
      id="nixie-progress"
      role="progressbar"
      aria-label="加载进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="加载进度 00.000000%"
    >
      <div class="nixie-loader__bank" aria-hidden="true">
        {
          tubeIndexes.map((tubeIndex) => (
            <>
              {tubeIndex === 2 && (
                <span class="nixie-separator">
                  <span />
                </span>
              )}
              <span
                class="nixie-tube"
                style={`--tube-index: ${tubeIndex}`}
                data-nixie-tube
              >
                <span class="nixie-tube__stem" />
                <span class="nixie-tube__glow" />
                <span class="nixie-tube__digits">
                  {digits.map((digit) => (
                    <span
                      class:list={[
                        'nixie-tube__digit',
                        { 'is-active': digit === '0' },
                      ]}
                      data-digit={digit}
                    >
                      {digit}
                    </span>
                  ))}
                </span>
                <span class="nixie-tube__mesh" />
                <span class="nixie-tube__glass" />
                <span class="nixie-tube__base" />
              </span>
            </>
          ))
        }
      </div>
    </div>
  </div>
</div>

<noscript
  ><style>
    .nixie-loader {
      display: none !important;
    }
  </style></noscript
>

<style>
  .nixie-loader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #ffffff;
    color: #0b0d10;
    transition:
      opacity 420ms var(--ease-reveal),
      filter 420ms var(--ease-reveal),
      visibility 420ms step-end;
  }

  :global(html[data-boot='seen']) .nixie-loader,
  .nixie-loader[hidden] {
    display: none;
  }

  .nixie-loader.is-closing {
    visibility: hidden;
    opacity: 0;
    filter: blur(2px);
  }

  .nixie-loader__apparatus {
    position: relative;
    width: min(94vw, 44rem);
    padding: clamp(1rem, 4vw, 2.5rem) clamp(0.4rem, 2vw, 1.25rem)
      clamp(1.8rem, 5vw, 3rem);
    isolation: isolate;
    animation: apparatus-enter 560ms var(--ease-reveal) both;
  }

  .nixie-loader__apparatus::before {
    position: absolute;
    z-index: -2;
    inset: 13% 3% 5%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgb(255 187 91 / 18%) 0%,
      rgb(255 164 58 / 9%) 38%,
      transparent 72%
    );
    content: '';
    filter: blur(clamp(12px, 3vw, 24px));
    transform: scaleX(0.94);
  }

  .nixie-loader__apparatus::after {
    position: absolute;
    z-index: -1;
    right: 8%;
    bottom: 3%;
    left: 8%;
    height: 8%;
    border-radius: 50%;
    background: rgb(20 35 40 / 15%);
    content: '';
    filter: blur(16px);
    transform: scaleY(0.56);
  }

  .nixie-loader__bank {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(0.2rem, 0.85vw, 0.52rem);
    perspective: 900px;
  }

  .nixie-tube {
    --tube-width: clamp(1.65rem, 5.5vw, 3.45rem);
    --tube-height: clamp(4.45rem, 12.8vw, 8.65rem);
    position: relative;
    display: block;
    width: var(--tube-width);
    height: var(--tube-height);
    flex: 0 0 var(--tube-width);
    margin-top: clamp(0.35rem, 1.1vw, 0.72rem);
    isolation: isolate;
    border: 1px solid rgb(86 110 119 / 56%);
    border-radius: 48% 48% 15% 15% / 10% 10% 5% 5%;
    background:
      radial-gradient(
        ellipse at 50% 50%,
        rgb(255 222 166 / 16%) 0%,
        rgb(255 166 55 / 8%) 34%,
        transparent 66%
      ),
      linear-gradient(
        96deg,
        rgb(255 255 255 / 92%) 0%,
        rgb(204 226 231 / 20%) 12%,
        rgb(255 255 255 / 5%) 34%,
        rgb(18 119 139 / 8%) 66%,
        rgb(255 255 255 / 76%) 88%,
        rgb(166 201 209 / 18%) 100%
      ),
      radial-gradient(
        ellipse at 50% 72%,
        rgb(20 132 151 / 11%),
        transparent 50%
      );
    box-shadow:
      inset 4px 0 6px rgb(255 255 255 / 84%),
      inset -3px 0 8px rgb(17 104 121 / 12%),
      inset 0 -10px 14px rgb(23 88 102 / 9%),
      inset 0 0 18px rgb(255 153 42 / 8%),
      0 1px 0 #ffffff,
      0 0 15px -8px rgb(255 153 42 / 52%),
      0 13px 18px -15px rgb(8 48 57 / 44%);
    transform-origin: 50% 100%;
    animation: tube-seat 500ms var(--ease-reveal) both;
    animation-delay: calc(70ms + var(--tube-index) * 28ms);
    contain: layout style;
  }

  .nixie-tube::before {
    position: absolute;
    top: clamp(-0.42rem, -0.7vw, -0.25rem);
    left: 50%;
    width: 24%;
    height: clamp(0.3rem, 0.9vw, 0.55rem);
    border: 1px solid rgb(89 115 123 / 46%);
    border-bottom: 0;
    border-radius: 50% 50% 18% 18% / 44% 44% 12% 12%;
    background: linear-gradient(
      90deg,
      rgb(213 230 234 / 48%),
      rgb(255 255 255 / 90%) 45%,
      rgb(142 188 199 / 28%)
    );
    content: '';
    transform: translateX(-50%);
  }

  .nixie-tube::after {
    position: absolute;
    z-index: 5;
    top: 8%;
    bottom: 16%;
    left: 11%;
    width: 12%;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(255 255 255 / 88%),
      transparent
    );
    content: '';
    filter: blur(0.35px);
    opacity: 0.76;
    box-shadow: 0 0 4px rgb(255 255 255 / 44%);
    transform: rotate(2deg);
  }

  .nixie-tube__glow {
    position: absolute;
    z-index: 0;
    inset: 9% -24% 8%;
    border-radius: 44%;
    background:
      radial-gradient(
        ellipse at 50% 43%,
        rgb(255 244 219 / 32%) 0% 7%,
        rgb(255 180 73 / 26%) 24%,
        rgb(255 137 27 / 10%) 48%,
        transparent 72%
      ),
      radial-gradient(
        ellipse at 50% 82%,
        rgb(255 161 49 / 18%),
        transparent 58%
      );
    filter: blur(clamp(4px, 0.8vw, 7px));
    opacity: 0.86;
    pointer-events: none;
  }

  .nixie-tube__stem {
    position: absolute;
    z-index: 1;
    top: 9%;
    right: 23%;
    bottom: 8%;
    left: 23%;
    border-right: 1px solid rgb(0 101 123 / 42%);
    border-left: 1px solid rgb(0 101 123 / 42%);
  }

  .nixie-tube__stem::before {
    position: absolute;
    top: 3%;
    right: -27%;
    left: -27%;
    height: 8%;
    border: 1px solid rgb(20 104 122 / 43%);
    border-radius: 50%;
    background: rgb(210 231 235 / 34%);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 24%);
    content: '';
  }

  .nixie-tube__stem::after {
    position: absolute;
    right: 18%;
    bottom: -2%;
    left: 18%;
    height: 29%;
    border-right: 1px solid rgb(15 90 107 / 48%);
    border-left: 1px solid rgb(15 90 107 / 48%);
    content: '';
  }

  .nixie-tube__digits {
    position: absolute;
    z-index: 2;
    inset: 12% 0 17%;
    display: grid;
    place-items: center;
  }

  .nixie-tube__digit {
    --digit-x: 0px;
    --digit-y: 0px;
    position: absolute;
    grid-area: 1 / 1;
    color: rgb(8 76 91 / 2%);
    font-family: 'Arial Narrow', 'Helvetica Neue', var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 3.65rem);
    font-stretch: condensed;
    font-weight: 300;
    line-height: 1;
    opacity: 0.2;
    transform: translate(var(--digit-x), var(--digit-y)) scaleX(0.72);
    -webkit-text-stroke: 0.68px rgb(31 87 97 / 68%);
    text-shadow: 0 1px 0 rgb(255 255 255 / 44%);
    transition: opacity 40ms linear;
  }

  .nixie-tube__digit::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    color: transparent;
    content: attr(data-digit);
    opacity: 0;
    -webkit-text-stroke: clamp(1.4px, 0.2vw, 2.1px)
      rgb(255 145 35 / 84%);
    filter: blur(clamp(2.8px, 0.55vw, 4.8px));
    pointer-events: none;
    transition: opacity 40ms linear;
  }

  .nixie-tube__digit:nth-child(2) {
    --digit-x: -0.35px;
    --digit-y: 0.35px;
  }

  .nixie-tube__digit:nth-child(3n) {
    --digit-x: 0.45px;
    --digit-y: -0.3px;
  }

  .nixie-tube__digit:nth-child(4n) {
    --digit-x: -0.2px;
    --digit-y: -0.45px;
  }

  .nixie-tube__digit.is-active {
    z-index: 2;
    color: rgb(255 218 158 / 14%);
    opacity: 1;
    -webkit-text-stroke: clamp(1.02px, 0.14vw, 1.55px) #ffad43;
    text-shadow:
      0 0 0.6px #ffffff,
      0 0 2px #ffe8bd,
      0 0 5px rgb(255 160 48 / 96%),
      0 0 11px rgb(244 137 30 / 72%),
      0 0 22px rgb(230 116 20 / 38%),
      0 0 36px rgb(220 103 16 / 16%);
    animation: cathode-switch 115ms linear both;
  }

  .nixie-tube__digit.is-active::before {
    opacity: 0.76;
  }

  .nixie-tube__mesh {
    position: absolute;
    z-index: 3;
    inset: 12% 13% 16%;
    border: 1px solid rgb(25 101 116 / 36%);
    border-radius: 45% 45% 8% 8% / 8% 8% 4% 4%;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0 4px,
        rgb(18 107 124 / 20%) 4px 5px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 4px,
        rgb(18 107 124 / 17%) 4px 5px
      );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 24%),
      0 0 5px rgb(13 117 138 / 8%),
      inset 0 0 9px rgb(255 157 45 / 7%);
    opacity: 0.68;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 8% 90%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 8% 90%,
      transparent
    );
    pointer-events: none;
  }

  .nixie-tube__glass {
    position: absolute;
    z-index: 4;
    inset: 1px;
    border-radius: inherit;
    background:
      radial-gradient(
        ellipse at 46% 4%,
        rgb(255 255 255 / 72%),
        transparent 24%
      ),
      linear-gradient(
        104deg,
        transparent 8%,
        rgb(255 255 255 / 36%) 15%,
        transparent 25% 70%,
        rgb(133 190 201 / 10%) 82%,
        transparent 92%
      ),
      radial-gradient(
        ellipse at 50% 84%,
        rgb(255 171 65 / 9%),
        transparent 48%
      );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 28%),
      inset 0 -13px 17px rgb(4 69 82 / 5%);
    opacity: 0.9;
    pointer-events: none;
  }

  .nixie-tube__base {
    position: absolute;
    z-index: 6;
    right: 4%;
    bottom: -13%;
    left: 4%;
    height: 19%;
    border: 1px solid rgb(89 111 118 / 70%);
    border-radius: 2px 2px 5px 5px;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 12%,
        rgb(25 104 122 / 11%) 12% 15%
      ),
      linear-gradient(
        180deg,
        #ffffff 0%,
        #dce8eb 24%,
        #8faeb5 39%,
        #f8fbfb 50%,
        #c8d9dd 77%,
        #ffffff 100%
      );
    box-shadow:
      inset 0 2px 1px rgb(255 255 255 / 86%),
      inset 0 7px 9px rgb(255 164 53 / 8%),
      0 5px 7px rgb(10 61 71 / 20%),
      0 0 11px -6px rgb(255 148 37 / 38%);
  }

  .nixie-tube__base::before,
  .nixie-tube__base::after {
    position: absolute;
    bottom: -30%;
    width: 1px;
    height: 34%;
    background: #69878d;
    box-shadow: 0 0 0 0.3px #dce8ea;
    content: '';
  }

  .nixie-tube__base::before {
    left: 28%;
  }

  .nixie-tube__base::after {
    right: 28%;
  }

  .nixie-separator {
    position: relative;
    display: grid;
    width: clamp(0.28rem, 1.1vw, 0.62rem);
    height: clamp(4.8rem, 13.9vw, 9.35rem);
    flex: 0 0 clamp(0.28rem, 1.1vw, 0.62rem);
    place-items: center;
  }

  .nixie-separator > span {
    position: relative;
    top: 18%;
    display: block;
    width: clamp(0.28rem, 0.95vw, 0.55rem);
    aspect-ratio: 1;
    border: 1px solid rgb(91 116 122 / 62%);
    border-radius: 50%;
    background: radial-gradient(
      circle at 38% 32%,
      #fff8df 0% 11%,
      #ffc66b 22%,
      rgb(229 161 55 / 72%) 54%,
      rgb(191 118 26 / 42%) 100%
    );
    box-shadow:
      inset 1px 1px 1px rgb(255 255 255 / 78%),
      0 0 2px #fff2cf,
      0 0 5px rgb(255 179 70 / 96%),
      0 0 12px rgb(228 140 31 / 62%),
      0 0 22px rgb(215 117 20 / 24%);
    animation: pilot-light 1.1s steps(2, end) infinite;
  }

  @keyframes apparatus-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tube-seat {
    0% {
      opacity: 0.3;
      transform: translateY(5px) rotateX(-2deg) scale(0.985);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotateX(0) scale(1);
    }
  }

  @keyframes cathode-switch {
    0% {
      opacity: 0.18;
      filter: brightness(0.52);
    }
    18% {
      opacity: 1;
      filter: brightness(1.62);
    }
    38% {
      opacity: 0.66;
      filter: brightness(0.82);
    }
    58% {
      opacity: 1;
      filter: brightness(1.18);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  @keyframes pilot-light {
    0%,
    92% {
      opacity: 1;
    }
    93% {
      opacity: 0.72;
    }
    96%,
    100% {
      opacity: 0.94;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nixie-loader {
      transition-duration: 120ms;
    }

    .nixie-loader__apparatus,
    .nixie-tube,
    .nixie-tube__digit.is-active,
    .nixie-separator > span {
      animation: none;
    }
  }
</style>

<script>
  function setupNixieLoader() {
    const root = document.documentElement
    const loader = document.getElementById('nixie-loader')
    const progress = document.getElementById('nixie-progress')
    const tubes = Array.from(
      document.querySelectorAll<HTMLElement>('[data-nixie-tube]'),
    )
    if (!(loader instanceof HTMLElement)) return

    let seen = root.dataset.boot === 'seen'
    try {
      seen ||= sessionStorage.getItem('institute-boot-seen') === '1'
    } catch {}

    if (seen) {
      loader.hidden = true
      root.dataset.boot = 'seen'
      return
    }

    if (loader.dataset.ready === 'true') return
    loader.dataset.ready = 'true'

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches
    const duration = 1650
    const startedAt = performance.now()
    let animationFrame = 0
    let hideTimer = 0
    let finishTimer = 0
    let lastPaint = -Infinity
    let finished = false

    const renderProgress = (value: number) => {
      const bounded = Math.min(99.999999, Math.max(0, value))
      const formatted = bounded.toFixed(6).padStart(9, '0')
      const characters = formatted.replace('.', '')

      tubes.forEach((tube, index) => {
        const nextDigit = characters[index]
        const active = tube.querySelector<HTMLElement>(
          '.nixie-tube__digit.is-active',
        )
        if (active?.dataset.digit === nextDigit) return
        active?.classList.remove('is-active')
        tube
          .querySelector<HTMLElement>(`[data-digit='${nextDigit}']`)
          ?.classList.add('is-active')
      })

      progress?.setAttribute('aria-valuenow', bounded.toFixed(3))
      progress?.setAttribute('aria-valuetext', `加载进度 ${formatted}%`)
    }

    const finish = () => {
      if (finished) return
      finished = true
      window.cancelAnimationFrame(animationFrame)
      window.clearTimeout(finishTimer)
      renderProgress(99.999999)
      loader.classList.add('is-closing')
      root.dataset.boot = 'seen'
      try {
        sessionStorage.setItem('institute-boot-seen', '1')
      } catch {}
      hideTimer = window.setTimeout(
        () => {
          loader.hidden = true
          document.dispatchEvent(new CustomEvent('nixie:complete'))
        },
        reducedMotion ? 120 : 440,
      )
    }

    const tick = (now: number) => {
      const elapsed = now - startedAt
      const ratio = Math.min(1, elapsed / duration)
      const eased = 1 - Math.pow(1 - ratio, 2.35)

      if (now - lastPaint >= 42 || ratio === 1) {
        renderProgress(
          ratio === 1 ? 99.999999 : Math.min(99.999998, eased * 99.999999),
        )
        lastPaint = now
      }

      if (ratio < 1) {
        animationFrame = window.requestAnimationFrame(tick)
      } else {
        finishTimer = window.setTimeout(finish, 210)
      }
    }

    renderProgress(0)

    if (reducedMotion) {
      renderProgress(99.999999)
      finishTimer = window.setTimeout(finish, 120)
    } else {
      animationFrame = window.requestAnimationFrame(tick)
    }

    window.addEventListener(
      'pagehide',
      () => {
        window.cancelAnimationFrame(animationFrame)
        window.clearTimeout(finishTimer)
        window.clearTimeout(hideTimer)
      },
      { once: true },
    )
  }

  setupNixieLoader()
  document.addEventListener('astro:page-load', setupNixieLoader)
</script>
