---
import Link from '@/components/link.astro'
import { NAV_LINKS } from '@/consts'
import { withBase } from '@/lib/paths'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`)
const logo = withBase('/static/future-game-laboratory-lockup.png')
---

<div class="site-nav-bar">
  <Link href="/" class="brand-lockup" aria-label="未来游戏研究所首页">
    <span class="brand-logo-window" aria-hidden="true">
      <img src={logo} alt="" width="225" height="65" />
    </span>
  </Link>

  <div class="desktop-navigation">
    <nav aria-label="主要导航">
      <ul>
        {
          NAV_LINKS.map((item) => (
            <li>
              <Link
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="navigation-controls">
    <button
      class="menu-trigger"
      id="site-menu-open"
      type="button"
      aria-haspopup="dialog"
      aria-controls="site-menu"
    >
      <span>MENU</span>
      <i aria-hidden="true"></i>
    </button>
  </div>
</div>

<dialog class="site-menu" id="site-menu" aria-label="网站导航">
  <header class="site-menu__header">
    <span class="site-menu__logo" aria-hidden="true">
      <img src={logo} alt="" width="225" height="65" />
    </span>
    <button id="site-menu-close" type="button" aria-label="关闭导航">
      <span>CLOSE</span>
      <i aria-hidden="true"></i>
    </button>
  </header>
  <nav class="site-menu__nav" aria-label="全屏导航">
    <ul>
      {
        NAV_LINKS.map((item) => (
          <li>
            <Link
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </Link>
          </li>
        ))
      }
    </ul>
  </nav>
  <footer class="site-menu__footer">
    <span>&copy; {new Date().getFullYear()} 未来游戏研究所</span>
    <Link href="/edits">EDITS ↗</Link>
  </footer>
</dialog>

<style>
  .site-nav-bar {
    display: flex;
    width: min(100%, var(--site-max));
    height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: auto;
    padding: 0 clamp(1rem, 3.3vw, 3rem);
  }

  .brand-lockup {
    display: block;
    flex: 0 0 auto;
  }

  .brand-logo-window {
    display: block;
    width: 11.75rem;
    aspect-ratio: 225 / 65;
  }

  .brand-logo-window img {
    display: block;
    width: 100%;
    height: auto;
    filter: var(--brand-logo-filter, none);
  }

  .desktop-navigation,
  .desktop-navigation nav ul,
  .navigation-controls {
    display: flex;
    align-items: center;
  }

  .desktop-navigation nav ul {
    gap: clamp(1rem, 2.4vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: block;
    color: color-mix(in srgb, var(--foreground) 66%, var(--background));
    line-height: 1.1;
  }

  .nav-link span {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -1.25rem;
    left: 0;
    height: 3px;
    background: var(--foreground);
    content: '';
    box-shadow:
      2px 0 var(--signal-magenta),
      -2px 0 var(--signal-cyan);
    transform: scaleX(0);
    transition: transform 180ms var(--ease-signal);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--foreground);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .navigation-controls {
    gap: 0.55rem;
  }

  .menu-trigger {
    display: none;
    height: 2.75rem;
    align-items: center;
    gap: 0.7rem;
    border: 1px solid var(--foreground);
    border-radius: 3px;
    background: transparent;
    color: var(--foreground);
    padding: 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
  }

  .menu-trigger i,
  .site-menu__header button i {
    position: relative;
    width: 1rem;
    height: 8px;
  }

  .menu-trigger i::before,
  .menu-trigger i::after,
  .site-menu__header button i::before,
  .site-menu__header button i::after {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .menu-trigger i::before {
    top: 0;
  }

  .menu-trigger i::after {
    bottom: 0;
  }

  .site-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    overflow: hidden auto;
    border: 0;
    background: #ffffff;
    color: #0b0d10;
    padding: 0;
    opacity: 0;
    transform: scale(1.025);
    transition:
      opacity 260ms var(--ease-signal),
      transform 480ms var(--ease-reveal),
      display 260ms allow-discrete,
      overlay 260ms allow-discrete;
  }

  .site-menu[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .site-menu[open] {
      opacity: 0;
      transform: scale(1.025);
    }
  }

  .site-menu::backdrop {
    background: rgb(255 255 255 / 96%);
  }

  .site-menu__header,
  .site-menu__footer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem clamp(1rem, 4vw, 3rem);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
  }

  .site-menu__header {
    border-bottom: 1px solid #b8bec4;
  }

  .site-menu__logo {
    display: block;
    width: 10.5rem;
    aspect-ratio: 225 / 65;
  }

  .site-menu__logo img {
    display: block;
    width: 100%;
    height: auto;
    filter: none;
  }

  .site-menu__header button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid #7d8387;
    border-radius: 3px;
    background: transparent;
    color: #0b0d10;
    padding: 0.65rem 0.75rem;
    font: inherit;
  }

  .site-menu__header button i::before {
    top: 3px;
    transform: rotate(45deg);
  }

  .site-menu__header button i::after {
    bottom: 4px;
    transform: rotate(-45deg);
  }

  .site-menu__nav {
    position: relative;
    display: grid;
    min-height: calc(100svh - 9rem);
    place-items: center;
    padding: clamp(2.5rem, 6vw, 6rem) clamp(1rem, 7vw, 7rem);
  }

  .site-menu__nav ul {
    width: min(100%, 64rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__nav li {
    border-bottom: 1px solid #b8bec4;
  }

  .site-menu__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.85rem, 2vw, 1.45rem) 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .site-menu__nav a:hover,
  .site-menu__nav a[aria-current='page'] {
    text-shadow:
      3px 0 #e2007a,
      -3px 0 #00c6d7;
  }

  .site-menu__footer {
    border-top: 1px solid #b8bec4;
    color: #575b60;
  }

  .site-menu__footer a:hover {
    color: #0b0d10;
  }

  :global(html[data-menu='open']) {
    overflow: hidden;
  }

  @media (max-width: 940px) {
    .desktop-navigation {
      display: none;
    }

    .menu-trigger {
      display: inline-flex;
    }
  }

  @media (max-width: 520px) {
    .brand-logo-window {
      width: 9.4rem;
    }

    .site-menu__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu {
      transform: none;
    }
  }
</style>

<script>
  function setupSiteMenu() {
    const dialog = document.getElementById('site-menu')
    const open = document.getElementById('site-menu-open')
    const close = document.getElementById('site-menu-close')
    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(open instanceof HTMLElement)
    )
      return

    open.onclick = () => {
      dialog.showModal()
      document.documentElement.dataset.menu = 'open'
      close?.focus()
    }
    const closeMenu = () => {
      dialog.close()
      delete document.documentElement.dataset.menu
      open.focus()
    }
    if (close instanceof HTMLElement) close.onclick = closeMenu
    dialog.onclick = (event) => {
      if (event.target === dialog) closeMenu()
    }
    dialog.onclose = () => delete document.documentElement.dataset.menu
    dialog.querySelectorAll('a').forEach((link) => {
      ;(link as HTMLAnchorElement).onclick = () => {
        if (dialog.open) dialog.close()
        delete document.documentElement.dataset.menu
      }
    })
  }

  setupSiteMenu()
  document.addEventListener('astro:page-load', setupSiteMenu)
</script>
