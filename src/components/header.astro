---
import Link from '@/components/link.astro'
import { NAV_LINKS } from '@/consts'
import { withBase } from '@/lib/paths'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(`${href}/`)
const logo = withBase('/static/future-game-laboratory-lockup.png')
---

<div class="site-nav-bar">
  <Link
    href="/"
    class="brand-lockup"
    aria-label="未来游戏研究所首页"
    data-astro-reload
  >
    <span class="brand-logo-window" aria-hidden="true">
      <img src={logo} alt="" width="225" height="65" />
    </span>
  </Link>

  <div class="desktop-navigation">
    <nav aria-label="主要导航">
      <ul>
        {
          NAV_LINKS.map((item) => (
            <li>
              <Link
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-page-switch-sound
              >
                <span>{item.label}</span>
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="navigation-controls">
    <button
      class="menu-trigger menu-toggle"
      id="site-menu-open"
      type="button"
      aria-label="打开导航"
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <span class="menu-icon" aria-hidden="true">
        <i class="menu-icon__line"></i>
        <i class="menu-icon__line"></i>
        <i class="menu-icon__line"></i>
      </span>
    </button>
  </div>
</div>

<dialog class="site-menu" id="site-menu" aria-label="网站导航">
  <header class="site-menu__header">
    <Link
      href="/"
      class="site-menu__logo"
      aria-label="未来游戏研究所首页"
      data-astro-reload
    >
      <img src={logo} alt="" width="225" height="65" />
    </Link>
    <button
      class="site-menu__toggle menu-toggle"
      id="site-menu-close"
      type="button"
      aria-label="关闭导航"
    >
      <span class="menu-icon" aria-hidden="true">
        <i class="menu-icon__line"></i>
        <i class="menu-icon__line"></i>
        <i class="menu-icon__line"></i>
      </span>
    </button>
  </header>
  <nav class="site-menu__nav" aria-label="全屏导航">
    <ul>
      {
        NAV_LINKS.map((item) => (
          <li>
            <Link
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              data-page-switch-sound
            >
              {item.label}
            </Link>
          </li>
        ))
      }
    </ul>
  </nav>
  <footer class="site-menu__footer">
    <span>&copy; {new Date().getFullYear()} 未来游戏研究所</span>
  </footer>
</dialog>

<style>
  .site-nav-bar {
    display: flex;
    width: min(100%, var(--site-max));
    height: var(--header-height);
    align-items: center;
    justify-content: flex-start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-inline: auto;
    padding: 0 var(--site-gutter);
  }

  .brand-lockup {
    display: block;
    flex: 0 0 auto;
  }

  .brand-logo-window {
    display: block;
    width: 11.75rem;
    aspect-ratio: 225 / 65;
  }

  .brand-logo-window img {
    display: block;
    width: 100%;
    height: auto;
    filter: var(--brand-logo-filter, none);
  }

  .desktop-navigation,
  .desktop-navigation nav ul,
  .navigation-controls {
    display: flex;
    align-items: center;
  }

  .desktop-navigation {
    margin-left: auto;
  }

  .desktop-navigation nav ul {
    gap: clamp(1rem, 2.4vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: block;
    color: color-mix(in srgb, var(--foreground) 66%, var(--background));
    line-height: 1.1;
  }

  .nav-link span {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -1.25rem;
    left: 0;
    height: 3px;
    background: var(--foreground);
    content: '';
    box-shadow:
      2px 0 var(--signal-magenta),
      -2px 0 var(--signal-cyan);
    transform: scaleX(0);
    transition: transform 180ms var(--ease-signal);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--foreground);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .navigation-controls {
    display: none;
    gap: 0.55rem;
    margin-left: 0;
  }

  .menu-toggle {
    height: 2.75rem;
    width: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    border-radius: 4px;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-signal),
      color 160ms var(--ease-signal),
      box-shadow 160ms var(--ease-signal);
  }

  .menu-trigger {
    display: none;
    background: #090909;
    color: #ffffff;
    box-shadow: var(--signal-shadow);
  }

  .menu-trigger:hover {
    background: #090909;
    color: #ffffff;
    box-shadow:
      3px 2px 0 rgb(226 0 122 / 78%),
      -3px -2px 0 rgb(0 198 215 / 78%);
  }

  .menu-icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.875rem;
  }

  .menu-icon__line {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 260ms var(--ease-signal),
      opacity 160ms var(--ease-signal);
  }

  .menu-icon__line:nth-child(1) {
    transform: translateY(0);
  }

  .menu-icon__line:nth-child(2) {
    transform: translateY(6px);
  }

  .menu-icon__line:nth-child(3) {
    transform: translateY(12px);
  }

  .site-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    overflow: hidden auto;
    border: 0;
    background: #090909;
    color: #ffffff;
    color-scheme: dark;
    padding: 0;
    opacity: 0;
    transition:
      opacity 260ms var(--ease-signal),
      display 260ms allow-discrete,
      overlay 260ms allow-discrete;
  }

  .site-menu[open][data-state='open'] {
    opacity: 1;
  }

  .site-menu[open][data-state='opening'],
  .site-menu[open][data-state='closing'] {
    opacity: 0;
  }

  .site-menu::backdrop {
    background: rgb(9 9 9 / 98%);
    opacity: 0;
    transition: opacity 220ms var(--ease-signal);
  }

  .site-menu[data-state='open']::backdrop {
    opacity: 1;
  }

  .site-menu__header,
  .site-menu__footer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--site-gutter);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
  }

  .site-menu__header {
    height: var(--header-height);
    border-bottom: 1px solid #3d3d3d;
    padding-inline-end: calc(
      var(--site-gutter) + var(--menu-scrollbar-compensation, 0px)
    );
  }

  .site-menu__logo {
    display: block;
    width: 11.75rem;
    aspect-ratio: 225 / 65;
  }

  .site-menu__logo img {
    display: block;
    width: 100%;
    height: auto;
    filter: invert(1);
  }

  .site-menu__toggle {
    display: inline-grid;
    background: #ffffff;
    color: #090909;
  }

  .site-menu__toggle:hover {
    background: #ffffff;
    color: #090909;
    box-shadow:
      2px 2px 0 rgb(226 0 122 / 64%),
      -2px -2px 0 rgb(0 198 215 / 64%);
  }

  .site-menu[data-state='open'] .menu-icon__line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-menu[data-state='open'] .menu-icon__line:nth-child(2) {
    opacity: 0;
    transform: translateY(6px) scaleX(0.35);
  }

  .site-menu[data-state='open'] .menu-icon__line:nth-child(3) {
    transform: translateY(6px) rotate(-45deg);
  }

  .site-menu__nav {
    position: relative;
    display: grid;
    min-height: calc(100svh - 9rem);
    place-items: center;
    padding: clamp(2.5rem, 6vw, 6rem) var(--site-gutter);
  }

  .site-menu__nav ul {
    width: min(100%, 64rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__nav li {
    border-bottom: 1px solid #3d3d3d;
  }

  .site-menu__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: #ffffff;
    padding: clamp(0.85rem, 2vw, 1.45rem) 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4.8rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .site-menu__nav a:hover,
  .site-menu__nav a[aria-current='page'] {
    text-shadow:
      3px 0 #e2007a,
      -3px 0 #00c6d7;
  }

  .site-menu__footer {
    border-top: 1px solid #3d3d3d;
    color: #b8bec4;
    justify-content: center;
    padding-block: 1.15rem;
    text-align: center;
  }

  .site-menu :global(:focus-visible) {
    outline-color: #00c6d7;
  }

  :global(html[data-menu='open']) {
    overflow: hidden;
    padding-inline-end: var(--menu-scrollbar-compensation, 0px);
  }

  @media (max-width: 940px) {
    .desktop-navigation {
      display: none;
    }

    .menu-trigger {
      display: inline-grid;
    }

    .navigation-controls {
      display: flex;
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .brand-logo-window {
      width: 9.4rem;
    }

    .site-menu__logo {
      width: 9.4rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon__line {
      transition-duration: 0.01ms;
    }

    .site-menu::backdrop {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  function setupSiteMenu() {
    const root = document.documentElement
    const dialog = document.getElementById('site-menu')
    const open = document.getElementById('site-menu-open')
    const close = document.getElementById('site-menu-close')
    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(open instanceof HTMLButtonElement) ||
      !(close instanceof HTMLButtonElement)
    )
      return

    let closeTimer: number | undefined
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    )

    const cleanUpMenu = () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer)
      closeTimer = undefined
      delete dialog.dataset.state
      delete root.dataset.menu
      root.style.removeProperty('--menu-scrollbar-compensation')
      open.setAttribute('aria-expanded', 'false')
    }

    open.onclick = () => {
      if (dialog.open) return
      const scrollbarWidth = Math.max(0, window.innerWidth - root.clientWidth)
      root.style.setProperty(
        '--menu-scrollbar-compensation',
        `${scrollbarWidth}px`,
      )
      dialog.dataset.state = 'opening'
      dialog.showModal()
      root.dataset.menu = 'open'
      open.setAttribute('aria-expanded', 'true')
      dialog.getBoundingClientRect()
      dialog.dataset.state = 'open'
      close.focus({ preventScroll: true })
    }

    const closeMenu = () => {
      if (!dialog.open || dialog.dataset.state === 'closing') return
      dialog.dataset.state = 'closing'
      open.setAttribute('aria-expanded', 'false')

      const finishClose = () => {
        if (dialog.open) dialog.close()
        cleanUpMenu()
        open.focus({ preventScroll: true })
      }

      if (reduceMotion.matches) {
        finishClose()
        return
      }

      closeTimer = window.setTimeout(finishClose, 280)
    }

    close.onclick = closeMenu
    dialog.onclick = (event) => {
      if (event.target === dialog) closeMenu()
    }
    dialog.oncancel = (event) => {
      event.preventDefault()
      closeMenu()
    }
    dialog.onclose = cleanUpMenu
    dialog.querySelectorAll('a').forEach((link) => {
      ;(link as HTMLAnchorElement).onclick = () => {
        if (dialog.open) dialog.close()
        cleanUpMenu()
      }
    })
  }

  setupSiteMenu()
  document.addEventListener('astro:page-load', setupSiteMenu)
</script>
