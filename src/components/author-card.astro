---
import Link from '@/components/link.astro'
import AvatarComponent from '@/components/ui/avatar'
import { cn } from '@/lib/utils'
import { withBase } from '@/lib/paths'
import type { CollectionEntry } from 'astro:content'

interface Props {
  author: CollectionEntry<'authors'>
}

const { author } = Astro.props
const { name, avatar, bio, pronouns } = author.data
const isAuthorPage = Astro.url.pathname === withBase(`/authors/${author.id}`)
---

<article class="author-record">
  <Link
    href={`/authors/${author.id}`}
    class={cn('author-record__portrait', isAuthorPage && 'pointer-events-none')}
    aria-label={`查看 ${name} 的作者资料`}
  >
    <AvatarComponent
      client:load
      src={withBase(avatar)}
      alt={`${name} 的头像`}
      fallback={name[0]}
      className="size-full rounded-none *:data-[slot='avatar-fallback']:rounded-none"
    />
  </Link>
  <div class="author-record__body">
    <p class="signal-label">CONTRIBUTOR / {author.id}</p>
    <div class="author-record__name">
      <h2>{name}</h2>
      {pronouns && <span>{pronouns}</span>}
    </div>
    <p>{bio || '暂无公开简介。'}</p>
  </div>
</article>

<style>
  .author-record {
    display: grid;
    grid-template-columns: minmax(8rem, 0.55fr) minmax(0, 1.45fr);
    overflow: hidden;
    border: 1px solid var(--foreground);
    background: var(--background);
  }

  .author-record__portrait {
    min-height: 15rem;
    overflow: hidden;
    border-right: 1px solid var(--foreground);
    background: var(--muted);
    filter: grayscale(1) contrast(1.05);
    transition: filter 220ms var(--ease-signal);
  }

  .author-record:hover .author-record__portrait {
    filter: grayscale(0.35) contrast(1.03);
  }

  .author-record__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .author-record__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .author-record h2 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: 680;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .author-record__name span {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .author-record__body > p:not(.signal-label) {
    margin: 1rem 0 1.5rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  @media (max-width: 520px) {
    .author-record {
      grid-template-columns: 1fr;
    }

    .author-record__portrait {
      min-height: 14rem;
      border-right: 0;
      border-bottom: 1px solid var(--foreground);
    }
  }
</style>
