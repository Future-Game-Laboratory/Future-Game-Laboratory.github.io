<style>
  .signal-field {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #0d1014;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .field-path {
    fill: none;
    stroke-width: 2;
  }

  .field-path--cyan {
    stroke: #00c6d7;
    opacity: 0.8;
  }

  .field-path--magenta {
    stroke: #e2007a;
    opacity: 0.8;
  }

  .field-path--main {
    stroke: #f0f3ef;
    stroke-dasharray: 4 7;
  }

  .field-monogram {
    fill: #f0f3ef;
    font-family: Geist, sans-serif;
    font-size: 146px;
    font-weight: 820;
    letter-spacing: -12px;
  }

  .field-monogram--cyan {
    fill: #00c6d7;
    opacity: 0.72;
  }

  .field-monogram--magenta {
    fill: #e2007a;
    opacity: 0.72;
  }

  .field-orbit,
  .field-core {
    transform-origin: 410px 408px;
    animation: field-breathe 8s var(--ease-signal) infinite alternate;
  }

  .field-core {
    animation-duration: 5.5s;
  }

  @keyframes field-breathe {
    from {
      transform: scale(0.985);
    }
    to {
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-orbit,
    .field-core {
      animation: none;
    }
  }
</style>
