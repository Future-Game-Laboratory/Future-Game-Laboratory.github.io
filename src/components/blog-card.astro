---
import { Badge } from '@/components/ui/badge'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { withBase } from '@/lib/paths'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
const year = entry.data.date.getFullYear()
const instituteLogo = withBase('/static/future-game-institute.png')
---

<article class="article-record">
  <Link
    href={`/${entry.collection}/${entry.id}`}
    aria-label={`阅读：${entry.data.title}`}
  >
    <div class="article-record__media">
      {
        entry.data.image ? (
          <Image
            src={entry.data.image}
            alt=""
            width={1200}
            height={630}
            loading="lazy"
          />
        ) : (
          <div class="article-record__placeholder" aria-hidden="true">
            <span>OBS / {year}</span>
            <img src={instituteLogo} alt="" width="225" height="225" />
            <i />
          </div>
        )
      }
    </div>

    <div class="article-record__body">
      <div class="article-record__meta">
        <span>{formattedDate}</span>
        <span>{readTime}</span>
        {
          authors.length > 0 && (
            <span>{authors.map((author) => author.name).join(' / ')}</span>
          )
        }
        {subpostCount > 0 && <span>{subpostCount} 个子记录</span>}
      </div>

      <h3 class="article-record__title">{entry.data.title}</h3>
      <p class="article-record__description">{entry.data.description}</p>

      <div class="article-record__footer">
        {
          entry.data.tags && (
            <div class="article-record__tags">
              {entry.data.tags.map((tag) => (
                <Badge variant="muted">
                  <Icon name="lucide:hash" class="size-3" />
                  {tag}
                </Badge>
              ))}
            </div>
          )
        }
        <span class="article-record__arrow" aria-hidden="true">↗</span>
      </div>
    </div>
  </Link>
</article>

<style>
  .article-record__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #090909;
    color: #ffffff;
    padding: 1rem;
  }

  .article-record__placeholder::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 8%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 8%) 1px, transparent 1px);
    background-size: 24px 24px;
    content: '';
    mask-image: linear-gradient(to bottom right, black, transparent);
  }

  .article-record__placeholder span {
    position: relative;
    color: #a8afb8;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .article-record__placeholder img {
    position: relative;
    align-self: flex-end;
    width: min(76%, 12rem);
    height: auto;
    filter: invert(1);
  }

  .article-record__placeholder i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38%;
    aspect-ratio: 1;
    border: 1px solid #69717c;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .article-record__footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-record__arrow {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    transition:
      background-color 160ms var(--ease-signal),
      color 160ms var(--ease-signal),
      transform 160ms var(--ease-signal);
  }

  .article-record:hover .article-record__arrow {
    background: var(--foreground);
    color: var(--background);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-record:hover .article-record__arrow {
      transform: none;
    }
  }
</style>
