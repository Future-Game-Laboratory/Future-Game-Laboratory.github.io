---
import Link from '@/components/link.astro'
import { cn } from '@/lib/utils'

const { newerPost, olderPost, parentPost } = Astro.props
const hasParent = !!parentPost
---

<nav
  class={cn('post-navigation', hasParent && 'post-navigation--with-parent')}
  aria-label="相邻文章"
>
  <Link
    href={olderPost ? `/blog/${olderPost.id}#post-title` : '#'}
    class={cn(
      'post-navigation__item post-navigation__item--previous',
      !olderPost && 'is-disabled',
    )}
    aria-disabled={!olderPost}
  >
    <span>← PREVIOUS</span>
    <strong>{olderPost?.data.title || '已经是最早的记录'}</strong>
  </Link>

  {
    hasParent && (
      <Link
        href={parentPost ? `/blog/${parentPost.id}#post-title` : '#'}
        class={cn(
          'post-navigation__item post-navigation__item--parent',
          !parentPost && 'is-disabled',
        )}
        aria-disabled={!parentPost}
      >
        <span>↑ PARENT</span>
        <strong>{parentPost?.data.title || '没有父记录'}</strong>
      </Link>
    )
  }

  <Link
    href={newerPost ? `/blog/${newerPost.id}#post-title` : '#'}
    class={cn(
      'post-navigation__item post-navigation__item--next',
      !newerPost && 'is-disabled',
    )}
    aria-disabled={!newerPost}
  >
    <span>NEXT →</span>
    <strong>{newerPost?.data.title || '已经是最新的记录'}</strong>
  </Link>
</nav>

<style>
  .post-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--foreground);
    background: var(--foreground);
  }

  .post-navigation--with-parent {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .post-navigation__item {
    display: flex;
    min-width: 0;
    min-height: 7.5rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    background: var(--background);
    color: var(--foreground);
    padding: 1rem;
    text-align: left;
    transition:
      background-color 160ms var(--ease-signal),
      color 160ms var(--ease-signal);
  }

  .post-navigation__item:hover:not(.is-disabled) {
    background: var(--foreground);
    color: var(--background);
  }

  .post-navigation__item--next {
    text-align: right;
  }

  .post-navigation__item--parent {
    text-align: center;
  }

  .post-navigation__item span {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .post-navigation__item:hover:not(.is-disabled) span {
    color: var(--signal-cyan);
  }

  .post-navigation__item strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 620;
    line-height: 1.25;
    text-overflow: ellipsis;
  }

  .is-disabled {
    pointer-events: none;
    opacity: 0.46;
  }

  @media (min-width: 768px) {
    .post-navigation {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .post-navigation,
    .post-navigation--with-parent {
      grid-template-columns: 1fr;
    }

    .post-navigation__item,
    .post-navigation__item--next,
    .post-navigation__item--parent {
      min-height: 5.75rem;
      text-align: left;
    }
  }
</style>
