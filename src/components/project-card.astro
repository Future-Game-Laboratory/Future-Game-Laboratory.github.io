---
import Link from '@/components/link.astro'
import { Badge } from '@/components/ui/badge'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<article class="project-record">
  <Link href={project.data.link} class="project-record__link" external>
    {
      project.data.image && (
        <div class="project-record__media">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={1200}
            height={630}
            class="size-full object-cover"
          />
        </div>
      )
    }
    <div class="project-record__body">
      <h3>{project.data.name}</h3>
      <p>{project.data.description}</p>
      {
        project.data.startDate && (
          <p class="project-record__date">
            <span class="flex items-center gap-x-1.5">
              <Icon name="lucide:calendar" class="size-3" />
              <span>
                {formatDate(project.data.startDate)}
                {project.data.endDate
                  ? ` → ${formatDate(project.data.endDate)}`
                  : ' → Present'}
              </span>
            </span>
          </p>
        )
      }
      {
        project.data.tags && (
          <div class="mt-4 flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <Badge variant="muted">{tag}</Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</article>

<style>
  .project-record {
    border-bottom: 1px solid var(--foreground);
  }

  .project-record__link {
    display: grid;
    grid-template-columns: minmax(11rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    padding: 1.25rem 0;
  }

  .project-record__media {
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid var(--foreground);
    filter: grayscale(0.8) contrast(1.05);
    transition: filter 200ms var(--ease-signal);
  }

  .project-record:hover .project-record__media {
    filter: grayscale(0.2) contrast(1.02);
  }

  .project-record__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-record h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 660;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .project-record__body > p:not(.project-record__date) {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .project-record__date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (max-width: 640px) {
    .project-record__link {
      grid-template-columns: 1fr;
    }
  }
</style>
