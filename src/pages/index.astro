---
import CoverCarousel from '@/components/cover-carousel.astro'
import HomeContact from '@/components/home-contact.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import TitleReveal from '@/components/title-reveal.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { withBase } from '@/lib/paths'
import { formatDate } from '@/lib/utils'
import { readdir } from 'node:fs/promises'
import { resolve } from 'node:path'

const announcements = await getRecentPosts(SITE.featuredPostCount)
const carouselDirectory = resolve(process.cwd(), 'public/static/carousel')
const carouselFiles = (
  await readdir(carouselDirectory).catch((error: unknown) => {
    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
      return []
    }

    throw error
  })
)
  .filter((file) => /\.(?:avif|jpe?g|png|webp)$/i.test(file))
  .sort((left, right) =>
    left.localeCompare(right, 'zh-CN', { numeric: true, sensitivity: 'base' }),
  )
const carouselSlides = carouselFiles.map((file, index) => ({
  src: withBase(`/static/carousel/${encodeURIComponent(file)}`),
  alt:
    file === '01-forked-light-cover.webp'
      ? '《歧光》封面：废墟中的两个人影望向贯穿天地的光'
      : `未来游戏研究所海报 ${String(index + 1).padStart(2, '0')}`,
}))
---

<Layout class="home-shell">
  <PageHead slot="head" title="未来游戏研究所" />

  <div class="front-page">
    <CoverCarousel slides={carouselSlides} />

    <section class="announcement-panel" aria-labelledby="announcement-title">
      <header class="announcement-heading">
        <div>
          <TitleReveal text="NEWS" id="announcement-title" />
          <p>INSTITUTE UPDATES / ACTIVITY LOG</p>
        </div>
        <Link href="/blog">VIEW ALL <span aria-hidden="true">→</span></Link>
      </header>

      {
        announcements.length > 0 ? (
          <ol class="announcement-list">
            {announcements.map((post) => (
              <li>
                <Link
                  href={`/${post.collection}/${post.id}`}
                  aria-label={`阅读公告：${post.data.title}`}
                >
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <div>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </Link>
              </li>
            ))}
          </ol>
        ) : (
          <p class="announcement-empty">目前没有公开公告。</p>
        )
      }
    </section>

    <HomeContact />
  </div>
</Layout>

<style>
  .front-page {
    width: min(100%, var(--site-max));
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3.3vw, 3rem)
      clamp(5rem, 9vw, 9rem);
  }

  .announcement-panel {
    max-width: 58rem;
    margin-top: clamp(4rem, 9vw, 9rem);
  }

  .announcement-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--foreground);
    padding-bottom: 1rem;
  }

  .announcement-heading :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 760;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .announcement-heading p {
    margin-top: 0.85rem;
    color: var(--muted-foreground);
  }

  .announcement-heading > a {
    flex: 0 0 auto;
    padding-bottom: 0.2rem;
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.35rem;
  }

  .announcement-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-list li {
    border-bottom: 1px solid var(--foreground);
  }

  .announcement-list a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: baseline;
    padding: clamp(1.35rem, 3vw, 2.1rem) 0;
    transition: padding-left 180ms var(--ease-signal);
  }

  .announcement-list a:hover {
    padding-left: 0.6rem;
  }

  .announcement-list time {
    color: var(--signal-magenta-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .announcement-list h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .announcement-list p {
    max-width: 62ch;
    margin-top: 0.65rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .announcement-list a > span {
    transition: transform 180ms var(--ease-signal);
  }

  .announcement-list a:hover > span {
    transform: translate(0.2rem, -0.2rem);
  }

  .announcement-empty {
    border-bottom: 1px solid var(--foreground);
    padding: 2rem 0;
    color: var(--muted-foreground);
  }

  @media (max-width: 640px) {
    .announcement-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .announcement-list a {
      grid-template-columns: 1fr auto;
    }

    .announcement-list time {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-list a:hover,
    .announcement-list a:hover > span {
      transform: none;
    }
  }
</style>
