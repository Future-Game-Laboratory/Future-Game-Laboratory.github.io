---
import CoverCarousel from '@/components/cover-carousel.astro'
import HomeContact from '@/components/home-contact.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import TitleReveal from '@/components/title-reveal.astro'
import { SITE } from '@/consts'
import home from '@/data/home.json'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { withBase } from '@/lib/paths'
import { formatDate } from '@/lib/utils'
import { readdir } from 'node:fs/promises'
import { resolve } from 'node:path'

const recentNews = await getRecentPosts(SITE.featuredPostCount)
const carouselDirectory = resolve(process.cwd(), 'public/static/carousel')
const carouselFiles = (
  await readdir(carouselDirectory).catch((error: unknown) => {
    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
      return []
    }

    throw error
  })
)
  .filter((file) => /\.(?:avif|jpe?g|png|webp)$/i.test(file))
  .sort((left, right) =>
    left.localeCompare(right, 'zh-CN', { numeric: true, sensitivity: 'base' }),
  )
const carouselSlides = carouselFiles.map((file, index) => ({
  src: withBase(`/static/carousel/${encodeURIComponent(file)}`),
  alt:
    file === '01-forked-light-cover.webp'
      ? '《歧光》封面：废墟中的两个人影望向贯穿天地的光'
      : `未来游戏研究所海报 ${String(index + 1).padStart(2, '0')}`,
}))
---

<Layout class="home-shell">
  <PageHead slot="head" title="未来游戏研究所" />

  <div class="front-page">
    <CoverCarousel slides={carouselSlides} />

    <div class="home-information">
      <aside class="home-sidebar" aria-label="社交账号与公告">
        <HomeContact />

        <section
          class="announcement-panel"
          aria-labelledby="announcement-title"
        >
          <h2 id="announcement-title">{home.announcement.title}</h2>
          <p>{home.announcement.body}</p>
        </section>
      </aside>

      <section class="news-panel" aria-labelledby="news-title">
        <header class="news-heading">
          <TitleReveal text="NEWS" id="news-title" />
          <Link href="/blog">
            VIEW ALL <span class="news-triangle" aria-hidden="true"></span>
          </Link>
        </header>

        {
          recentNews.length > 0 ? (
            <ol class="news-list">
              {recentNews.map((post) => (
                <li>
                  <Link
                    href={`/${post.collection}/${post.id}`}
                    aria-label={`阅读动态：${post.data.title}`}
                  >
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    <div>
                      <h2>{post.data.title}</h2>
                      <p>{post.data.description}</p>
                    </div>
                    <span class="news-triangle" aria-hidden="true"></span>
                  </Link>
                </li>
              ))}
            </ol>
          ) : (
            <p class="news-empty">目前没有公开动态。</p>
          )
        }
      </section>
    </div>
  </div>
</Layout>

<style>
  .front-page {
    width: min(100%, var(--site-max));
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem) var(--site-gutter)
      clamp(4rem, 8vw, 6rem);
  }

  .home-information {
    display: grid;
    grid-template-areas: 'news sidebar';
    grid-template-columns: minmax(0, 2fr) minmax(15rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .news-panel {
    grid-area: news;
    min-width: 0;
  }

  .home-sidebar {
    display: grid;
    grid-area: sidebar;
    width: 100%;
    gap: 1.5rem;
  }

  .news-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--foreground);
    padding-bottom: 0.75rem;
  }

  .news-heading :global(h1) {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 760;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .news-heading > a {
    display: inline-flex;
    min-height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    border-radius: 4px;
    background: var(--foreground);
    color: var(--background);
    padding: 0.65rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    transition: box-shadow 160ms var(--ease-signal);
  }

  .news-heading > a:hover {
    box-shadow: var(--signal-shadow);
  }

  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-list li {
    border-bottom: 1px solid var(--foreground);
  }

  .news-list a {
    position: relative;
    display: grid;
    grid-template-areas:
      'content time'
      'content marker';
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding: 1.25rem 0;
  }

  .news-list time {
    grid-area: time;
    justify-self: end;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .news-list h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .news-list p {
    max-width: 58ch;
    margin-top: 0.4rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .news-list a > div {
    grid-area: content;
    min-width: 0;
  }

  .news-triangle {
    display: inline-block;
    width: 0;
    height: 0;
    flex: 0 0 auto;
    border-top: 0.28rem solid transparent;
    border-bottom: 0.28rem solid transparent;
    border-left: 0.46rem solid currentColor;
    transform-origin: center;
    transition: transform 220ms var(--ease-signal);
  }

  .news-list a > .news-triangle {
    grid-area: marker;
    align-self: end;
    justify-self: end;
    margin-bottom: 0.2rem;
  }

  .news-heading > a:hover .news-triangle,
  .news-heading > a:focus-visible .news-triangle,
  .news-list a:hover > .news-triangle,
  .news-list a:focus-visible > .news-triangle {
    transform: translateX(0.35rem) scaleX(1.15);
  }

  .news-empty {
    border-bottom: 1px solid var(--foreground);
    padding: 1.5rem 0;
    color: var(--muted-foreground);
  }

  .announcement-panel {
    width: 100%;
  }

  .announcement-panel h2 {
    border-bottom: 1px solid var(--foreground);
    padding-bottom: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1;
  }

  .announcement-panel p {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    line-height: 1.8;
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .home-information {
      grid-template-areas:
        'sidebar'
        'news';
      grid-template-columns: minmax(0, 1fr);
      gap: 4rem;
    }

    .home-sidebar,
    .news-panel {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .news-heading {
      align-items: flex-end;
      gap: 0.75rem;
    }

    .news-heading :global(h1) {
      font-size: clamp(2.4rem, 14vw, 3.25rem);
    }

    .news-heading > a {
      min-height: 2.75rem;
      padding-inline: 0.75rem;
    }

    .news-list a {
      gap: 0.55rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-heading > a,
    .news-triangle {
      transition: none;
    }

    .news-heading > a:hover .news-triangle,
    .news-heading > a:focus-visible .news-triangle,
    .news-list a:hover > .news-triangle,
    .news-list a:focus-visible > .news-triangle {
      transform: none;
    }
  }
</style>
