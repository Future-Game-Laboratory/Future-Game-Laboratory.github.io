---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { withBase } from '@/lib/paths'
import { formatDate } from '@/lib/utils'

const announcements = await getRecentPosts(SITE.featuredPostCount)
const cover = withBase('/static/forked-light-cover.webp')
---

<Layout class="home-shell">
  <PageHead slot="head" title="未来游戏研究所" />

  <div class="front-page">
    <figure class="home-cover">
      <img
        src={cover}
        width="2200"
        height="1401"
        alt="《歧光》封面：废墟中的两个人影望向贯穿天地的光"
      />
    </figure>

    <section class="announcement-panel" aria-labelledby="announcement-title">
      <header class="announcement-heading">
        <div>
          <h1 id="announcement-title">Information</h1>
          <p>公告与站点更新</p>
        </div>
        <Link href="/blog">全部公告 <span aria-hidden="true">→</span></Link>
      </header>

      {
        announcements.length > 0 ? (
          <ol class="announcement-list">
            {announcements.map((post) => (
              <li>
                <Link
                  href={`/${post.collection}/${post.id}`}
                  aria-label={`阅读公告：${post.data.title}`}
                >
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <div>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </Link>
              </li>
            ))}
          </ol>
        ) : (
          <p class="announcement-empty">目前没有公开公告。</p>
        )
      }
    </section>
  </div>
</Layout>

<style>
  .front-page {
    width: min(100%, var(--site-max));
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3.3vw, 3rem)
      clamp(5rem, 9vw, 9rem);
  }

  .home-cover {
    margin: 0;
    overflow: hidden;
    border-top: 1px solid var(--foreground);
    border-bottom: 1px solid var(--foreground);
    background: #090b12;
  }

  .home-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .announcement-panel {
    max-width: 66rem;
    margin-top: clamp(4rem, 9vw, 9rem);
  }

  .announcement-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 2px solid var(--foreground);
    padding-bottom: 1rem;
  }

  .announcement-heading h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-weight: 760;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .announcement-heading p {
    margin-top: 0.85rem;
    color: var(--muted-foreground);
  }

  .announcement-heading > a {
    flex: 0 0 auto;
    padding-bottom: 0.2rem;
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.35rem;
  }

  .announcement-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-list li {
    border-bottom: 1px solid var(--foreground);
  }

  .announcement-list a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: baseline;
    padding: clamp(1.35rem, 3vw, 2.1rem) 0;
    transition: padding-left 180ms var(--ease-signal);
  }

  .announcement-list a:hover {
    padding-left: 0.6rem;
  }

  .announcement-list time {
    color: var(--signal-magenta-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .announcement-list h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .announcement-list p {
    max-width: 62ch;
    margin-top: 0.65rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .announcement-list a > span {
    transition: transform 180ms var(--ease-signal);
  }

  .announcement-list a:hover > span {
    transform: translate(0.2rem, -0.2rem);
  }

  .announcement-empty {
    border-bottom: 1px solid var(--foreground);
    padding: 2rem 0;
    color: var(--muted-foreground);
  }

  @media (max-width: 640px) {
    .announcement-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .announcement-list a {
      grid-template-columns: 1fr auto;
    }

    .announcement-list time {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-list a:hover,
    .announcement-list a:hover > span {
      transform: none;
    }
  }
</style>
