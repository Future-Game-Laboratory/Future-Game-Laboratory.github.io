---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import TitleReveal from '@/components/title-reveal.astro'
import { CONTACT } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'

const socialLinks = CONTACT.socials.filter((channel) => channel.href.trim())
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title="CONTACT"
    description="联系未来游戏研究所，提出合作、内容纠错或加入意向。"
  />

  <article class="contact-document">
    <header class="contact-heading">
      <TitleReveal text="CONTACT" />
    </header>
    <p class="contact-intro">
      研究合作、内容纠错、活动邀请与加入意向，都可以通过以下方式与未来游戏研究所联系。
    </p>

    <section aria-labelledby="email-heading">
      <h2 id="email-heading">EMAIL</h2>
      {
        CONTACT.email ? (
          <Link class="contact-email" href={`mailto:${CONTACT.email}`} external>
            {CONTACT.email}
          </Link>
        ) : (
          <p class="contact-unconfigured">邮箱暂未配置。</p>
        )
      }
    </section>

    {
      socialLinks.length > 0 && (
        <section aria-labelledby="sns-heading">
          <h2 id="sns-heading">SNS</h2>
          <nav class="social-buttons" aria-label="社交平台">
            {socialLinks.map((channel) => (
              <Link
                href={channel.href}
                external
                class="social-button"
                aria-label={channel.label}
                title={channel.label}
              >
                <Icon name={channel.icon} aria-hidden="true" />
              </Link>
            ))}
          </nav>
        </section>
      )
    }

    <p class="contact-note">请不要通过公开平台发送不应公开的个人信息。</p>
  </article>
</Layout>

<style>
  .contact-document {
    width: 100%;
    max-width: 60rem;
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .contact-heading {
    border-bottom: 2px solid var(--foreground);
    padding-bottom: 0.45rem;
  }

  .contact-heading :global(h1) {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .contact-intro {
    max-width: 56rem;
    margin-top: 2.5rem;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .contact-document section {
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }

  .contact-document h2 {
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-email {
    display: inline-block;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.35rem;
    overflow-wrap: anywhere;
  }

  .contact-unconfigured,
  .contact-note {
    color: var(--muted-foreground);
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social-button {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--foreground);
    border-radius: 50%;
    transition:
      transform 160ms var(--ease-signal),
      background-color 160ms var(--ease-signal),
      color 160ms var(--ease-signal),
      box-shadow 160ms var(--ease-signal);
  }

  .social-button :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .social-button:hover {
    transform: translateY(-2px);
    background: var(--foreground);
    color: var(--background);
    box-shadow: var(--signal-shadow);
  }

  .contact-note {
    margin-top: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-button:hover {
      transform: none;
    }
  }
</style>
