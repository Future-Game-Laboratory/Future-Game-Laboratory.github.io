---
import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
import PageHeader from '@/components/page-header.astro'
import Layout from '@/layouts/layout.astro'
import { getAllTags, getPostsByTag } from '@/lib/data-utils'

export async function getStaticPaths() {
  const tagMap = await getAllTags()
  return Promise.all(
    Array.from(tagMap.keys()).map(async (tag) => ({
      params: { id: tag },
      props: { tag, posts: await getPostsByTag(tag) },
    })),
  )
}

const { tag, posts } = Astro.props
---

<Layout class="max-w-6xl">
  <PageHead
    slot="head"
    title={`TAG: ${tag}`}
    description={`标记为 ${tag} 的文章集合。`}
    noindex
  />
  <PageHeader
    label={`FILTER / ${String(posts.length).padStart(2, '0')} ARTICLES`}
    title={`# ${tag}`}
    description="当前标签下的全部公开文章。"
  />
  <div class="article-list">
    {posts.map((post) => <BlogCard entry={post} />)}
  </div>
</Layout>
