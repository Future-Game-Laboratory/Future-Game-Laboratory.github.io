---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="关于" />
  <Breadcrumbs items={[{ label: '关于', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <h1>关于 Future Game Laboratory</h1>
        <p>
          Future Game Laboratory 是一个围绕游戏研究与创作实践展开的开放实验室。我们把游戏视为技术系统、表达媒介，也是理解人与社会的一种方法。
        </p>
        <p>
          这个 Blog 用来保存那些值得公开的过程：设计决策、工程问题、实验记录、失败复盘，以及仍在生长中的想法。文章不必伪装成最终答案；可验证的过程本身就有价值。
        </p>
        <h2>我们关注什么</h2>
        <ul>
          <li>游戏机制、叙事与玩家体验的研究</li>
          <li>游戏开发工具、工程方法与技术实验</li>
          <li>原型、项目和创作过程的复盘</li>
          <li>与游戏文化相关的观察和讨论</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
