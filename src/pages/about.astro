---
import PageHead from '@/components/page-head.astro'
import TitleReveal from '@/components/title-reveal.astro'
import Layout from '@/layouts/layout.astro'
import { getEntry, render } from 'astro:content'

const about = await getEntry('pages', 'about')
if (!about) throw new Error('Missing about page content')
const { Content } = await render(about)
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title={about.data.title}
    description={about.data.description}
  />

  <header class="about-heading">
    <TitleReveal text="ABOUT" />
  </header>

  <article class="prose about-document">
    <Content />
  </article>
</Layout>

<style>
  .about-document {
    width: 100%;
    max-width: 60rem;
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .about-heading {
    border-bottom: 2px solid var(--foreground);
    padding-bottom: 0.45rem;
  }

  .about-heading :global(h1) {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .about-document :global(h2) {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-document :global(p) {
    max-width: 70ch;
  }

  .about-document :global(img) {
    width: min(100%, 34rem);
    margin: clamp(2rem, 6vw, 4rem) 0;
    filter: var(--brand-logo-filter, none);
  }
</style>
