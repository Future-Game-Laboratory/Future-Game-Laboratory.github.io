---
import ProjectCard from '@/components/project-card.astro'
import PageHead from '@/components/page-head.astro'
import TitleReveal from '@/components/title-reveal.astro'
import Layout from '@/layouts/layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { getEntry, render } from 'astro:content'

const works = await getEntry('pages', 'works')
if (!works) throw new Error('Missing works page content')
const { Content } = await render(works)
const projects = await getAllProjects()
const hasIntroduction = Boolean(works.body?.trim())
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title={works.data.title}
    description={works.data.description}
  />

  <header class="works-heading">
    <TitleReveal text="WORKS" />
  </header>

  {
    hasIntroduction && (
      <article class="prose works-document">
        <Content />
      </article>
    )
  }

  {
    projects.length > 0 && (
      <section class="works-projects" aria-labelledby="works-projects-title">
        <h2 id="works-projects-title">PROJECTS</h2>
        <div class="works-projects__list">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }
</Layout>

<style>
  .works-heading {
    padding-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  .works-heading :global(h1) {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .works-document {
    width: 100%;
    max-width: 60rem;
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .works-document :global(h2) {
    max-width: 14ch;
    margin-top: clamp(3rem, 7vw, 5.5rem);
    border: 0;
    padding: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .works-document :global(p) {
    max-width: 70ch;
  }

  .works-projects {
    width: 100%;
    max-width: 60rem;
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .works-projects > h2 {
    margin: clamp(3rem, 7vw, 5.5rem) 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 740;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .works-projects__list {
    display: grid;
    border-top: 1px solid var(--foreground);
  }
</style>
