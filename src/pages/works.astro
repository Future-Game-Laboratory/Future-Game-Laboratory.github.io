---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import PageHeader from '@/components/page-header.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-6xl">
  <PageHead
    slot="head"
    title="项目"
    description="未来游戏研究所的研究计划、游戏原型与公开项目。"
  />
  <Breadcrumbs items={[{ label: '项目', icon: 'lucide:layers-3' }]} />
  <PageHeader
    label="WORKS / PROJECTS"
    title="项目与活动"
    description="这里整理研究计划、游戏原型、公开活动与协作项目。项目材料会在具备足够上下文后逐步公开。"
  />

  <section class="works-intro">
    <p class="works-index">W / 001</p>
    <div>
      <h2>首批项目档案正在整理</h2>
      <p>
        我们不会使用示例项目填充目录。项目公开后，这里会提供目标、过程、阶段成果和相关研究记录，而不只是最终展示。
      </p>
      <Link href="/blog" class={buttonVariants({ variant: 'outline' })}>
        先阅读研究资讯 <span aria-hidden="true">→</span>
      </Link>
    </div>
  </section>
</Layout>

<style>
  .works-intro {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 8vw, 8rem);
    border-top: 1px solid var(--foreground);
    border-bottom: 1px solid var(--foreground);
    padding: clamp(2.5rem, 7vw, 6rem) 0;
  }

  .works-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .works-intro h2 {
    max-width: 14ch;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .works-intro div > p {
    max-width: 50rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted-foreground);
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .works-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
