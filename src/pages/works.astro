---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import PageHeader from '@/components/page-header.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-6xl">
  <PageHead
    slot="head"
    title="WORKS"
    description="未来游戏研究所的研究计划、游戏原型与公开项目。"
  />
  <PageHeader
    title="WORKS"
    description="这里整理研究计划、游戏原型、公开活动与协作项目。项目材料会在具备足够上下文后逐步公开。"
  />

  <section class="works-intro">
    <h2>首批项目档案正在整理</h2>
    <p>
      我们不会使用示例项目填充目录。项目公开后，这里会提供目标、过程、阶段成果和相关研究记录，而不只是最终展示。
    </p>
    <Link href="/blog" class={buttonVariants({ variant: 'outline' })}>
      先阅读研究资讯 <span aria-hidden="true">→</span>
    </Link>
  </section>
</Layout>

<style>
  .works-intro {
    width: 100%;
    max-width: 50rem;
    padding-bottom: clamp(2.5rem, 7vw, 6rem);
  }

  .works-intro h2 {
    max-width: 14ch;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .works-intro > p {
    max-width: 50rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted-foreground);
    line-height: 1.8;
  }
</style>
