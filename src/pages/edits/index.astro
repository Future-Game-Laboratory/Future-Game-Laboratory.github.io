---
import ContentManager from '@/components/content-manager'
import PageHead from '@/components/page-head.astro'
import EditorLayout from '@/layouts/editor-layout.astro'

const repository = {
  owner: 'Future-Game-Laboratory',
  repo: 'Future-Game-Laboratory.github.io',
  branch: 'main',
}
const oauthProxy = import.meta.env.PUBLIC_GITHUB_OAUTH_PROXY?.replace(/\/$/, '') ?? ''
---

<EditorLayout>
  <PageHead
    slot="head"
    title="EDITS"
    description="未来游戏研究所内容管理后台"
    noindex
  />
  <ContentManager client:load repository={repository} oauthProxy={oauthProxy} />
</EditorLayout>
